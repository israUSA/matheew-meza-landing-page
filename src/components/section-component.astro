---
const { id } = Astro.props;
---

<section
  id={id}
  class="gradient section py-8 px-4 sm:mx-4 md:mx-8 md:px-16 bg-[var(--color-background-section)] text-[var(--color-text)]"
>
  <slot />
</section>

