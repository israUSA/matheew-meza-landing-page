---
import { Image } from "astro:assets";
import photoWelcome from "../assets/welcome_trainer.png";
---

<section
  class="min-h-screen flex flex-col  md:justify-evenly lg:justify-start  sm:py-4 sm:px-4 md:px-8 bg-background text-center md:text-left lg:text-left"
>
  <!-- Contenido superior -->
  <div class="sm:flex md:flex flex-row items-center">
    <div>
      <h1 class="text-4xl md:text-5xl font-bold text-primary mb-4">
        Entrenador Personal Fitness
      </h1>
      <h2 class="text-xl md:text-2xl text-text-offset mb-6">
        Transforma tu cuerpo, eleva tu mente y alcanza tus metas con un plan a
        tu medida y un enfoque personalizado.
      </h2>
      <p class="text-md md:text-2xl text-text max-w-2xl mb-6">
        Desde quemar grasa hasta ganar fuerza, cada sesión está diseñada para
        ti.
      </p>
      <p class="text-md md:text-2xl text-text max-w-2xl">¡Contáctame y empecemos tu viaje hoy!
      </p>
    </div>
    <Image
      src={photoWelcome}
      class="shadowfilter w-full md:max-w-md lg:max-w-xl mx-auto md:mx-0"
      alt="Descripción de la imagen"
    />
  </div>

  <!-- Botón al final -->
  <div class="flex justify-center mb-8">
    <a
      href="#contacto"
      class="button inline-block bg-secondary px-6 py-3 rounded-lg hover:bg-opacity-90 transition"
    >
      Comienza ahora
    </a>
  </div>
</section>





<style>
  .shadowfilter {
    -webkit-filter: drop-shadow(0px 0px 30px rgba(13, 9, 7, 0.5));
    -webkit-transition: all 0.5s linear;
    -o-transition: all 0.5s linear;
    transition: all 0.5s linear;
  }

  :global(.dark) .shadowfilter {
    -webkit-filter: drop-shadow(0px 0px 30px rgba(204, 168, 72, 0.5));
  }
</style>
